# LinkedIn-Messe-PWA
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    # HTTPS erzwingen
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    # Interna nie ausliefern
    RewriteRule ^(lib|data|vendor)(/|$) - [F,L]
    RewriteRule ^(config\.php|config\.sample\.php|composer\.(json|lock))$ - [F,L]
</IfModule>

<FilesMatch "^(config\.php|config\.sample\.php|composer\.(json|lock))$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set X-Frame-Options "DENY"
    <FilesMatch "^(sw\.js|index\.html|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

AddType application/manifest+json .webmanifest

# Große Fotos erlauben (nur wirksam, wenn der Hoster php_value zulässt – sonst per .user.ini)
<IfModule mod_php.c>
    php_value upload_max_filesize 16M
    php_value post_max_size 20M
</IfModule>
