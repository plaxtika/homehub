{
    "name": "plaxtika/linkedin-messe",
    "description": "PWA zum schnellen Posten von LinkedIn-Beiträgen auf Messen",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "anthropic-ai/sdk": "^0.54",
        "guzzlehttp/guzzle": "^7.9"
    },
    "config": {
        "platform": { "php": "8.1.0" },
        "optimize-autoloader": true,
        "allow-plugins": { "php-http/discovery": true }
    }
}
